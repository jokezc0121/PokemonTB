# Copiar como .env y completar. Nunca subir .env a Git.

# Puerto del servidor
PORT=3000
NODE_ENV=development

# Supabase > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...). Solo vive en el backend: omite RLS.
SUPABASE_SECRET_KEY=
# Bucket privado donde se guardan los archivos de los usuarios
SUPABASE_BUCKET=archivos

# Firma de los tokens de sesión. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_HOURS=12

# Orígenes del frontend autorizados por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Opcional, solo para `npm run db:migrate`
# Supabase > Project Settings > Database > Connection string > URI
DATABASE_URL=
